{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "default",
    "model": "openai/gpt-5.6-terra",
    "small_model": "openai/gpt-5.6-luna",
    "autoupdate": false,
    "compaction": {
        "prune": true
    },
    "agent": {
        "build": {
            "disable": true
        },
        "general": {
            "disable": true
        },
        "explore": {
            "disable": true
        },
        "plan": {
            "disable": true
        },
        "scout": {
            "disable": true
        }
    },
    "server": {
        "port": 4097
    },
    "lsp": {
        "rust": {
            "command": ["rust-analyzer"]
        },
        "gopls": {
            "command": ["gopls"]
        },
        "typescript": {
            "command": ["typescript-language-server", "--stdio"]
        },
        "yaml-ls": {
            "command": ["yaml-language-server", "--stdio"]
        },
        "pyright": {
            "command": ["pyright-langserver", "--stdio"]
        },
        "bash": {
            "command": ["bash-language-server", "start"]
        },
        "json": {
            "command": ["vscode-json-language-server", "--stdio"],
            "extensions": [".json", ".jsonc"]
        },
        "sql": {
            "command": ["sqls"],
            "extensions": [".sql"]
        }
    },
    "formatter": true,
    "mcp": {
        "github": {
            "type": "remote",
            "url": "https://api.githubcopilot.com/mcp/",
            "enabled": false,
            "oauth": false,
            "timeout": 10000,
            "headers": {
                "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
            }
        }
    },
    "permission": {
        "*": "deny",
        "read": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny",
            "*.env.example": "allow"
        },
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "edit": "deny",
        "doom_loop": "ask",
        "project_*": "deny",
        "task": "deny",
        "external_directory": {
            "*": "deny",
            "**/.opencode-worktrees/**": "allow"
        },
        "bash": "deny"
    },
    "provider": {
        "openai": {
            "options": {
                "apiKey": "{env:PERSONAL_OPENAI_API_KEY}"
            },
            "models": {
                "gpt-5.6-sol": {},
                "gpt-5.6-terra": {},
                "gpt-5.6-luna": {}
            }
        }
    }
}
